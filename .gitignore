# Pixelian template - files to keep out of version control.
# Sections are grouped by source. Uncomment or extend as your project
# adds new tooling (bundler, tests, etc.).

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.settings/
*.code-workspace

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# Node (when a bundler is added)
node_modules/
.pnpm-store/

# Build output (when a bundler is added)
dist/
build/
.cache/
.parcel-cache/
.next/
.nuxt/

# PHP / Composer (when Laravel arrives)
vendor/
*.phar

# Lockfiles - APPLICATION projects should commit these for
# reproducible deploys. The lines below are for LIBRARY-style
# projects (published to a registry), where lockfiles are typically
# omitted. The Pixelian template spawns client applications, so leave
# them commented out unless you have a specific reason to exclude
# them.
# composer.lock
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Local dev artifacts
*.local
*.tmp
*.bak
*.orig

# IDE / tool caches
.idea_modules/
.angular/
.sass-cache/
coverage/

# Test output
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/